#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import fcntl
import tempfile
from pathlib import Path
import re
import subprocess
import sys
import time

ROOT = Path(os.environ.get("CODEX_ACCOUNT_MANAGER_HOME", Path.home() / ".codex-manager"))
CFG = ROOT / "manager.json"
CACHE = ROOT / "runtime-cache.json"
LOCK = ROOT / ".runtime.lock"
WRAPPER = Path.home() / ".local/lib/codex-manager/bin/codex"
SELF = Path(__file__)
DEFAULT_TTL = 300


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


class RuntimeLock:
    def __enter__(self):
        ROOT.mkdir(parents=True, exist_ok=True)
        self.f = LOCK.open("a+")
        fcntl.flock(self.f.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *_):
        fcntl.flock(self.f.fileno(), fcntl.LOCK_UN)
        self.f.close()


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write("\n")
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def is_manager_wrapper(path: Path) -> bool:
    try:
        if WRAPPER.exists() and path.exists() and os.path.samefile(path, WRAPPER):
            return True
    except OSError:
        pass

    try:
        if path.exists() and os.path.samefile(path, SELF):
            return True
    except OSError:
        pass

    # Detect the legacy v1.1 wrapper that lived at ~/.local/bin/codex.
    try:
        if path.is_file() and path.stat().st_size < 65536:
            head = path.read_text(errors="ignore")[:4096]
            if "CODEX_ACCOUNT_MANAGER_BIN" in head and "codex-account" in head:
                return True
    except (OSError, UnicodeError):
        pass

    return False


def add_candidate(out: list[Path], value: str | Path | None) -> None:
    if not value:
        return
    p = Path(value).expanduser()
    try:
        if not p.exists() or not os.access(p, os.X_OK) or is_manager_wrapper(p):
            return
    except OSError:
        return

    if all(str(existing) != str(p) for existing in out):
        out.append(p)


def candidates() -> list[Path]:
    out: list[Path] = []
    cfg = load_json(CFG)

    add_candidate(out, os.environ.get("CODEX_REAL_OVERRIDE"))

    for hint in cfg.get("codex_runtime_hints", []) or []:
        add_candidate(out, hint)

    # Official standalone visible command. Our v1.2 wrapper no longer occupies it.
    add_candidate(out, Path.home() / ".local/bin/codex")

    # Default standalone installation.
    default_home = Path.home() / ".codex"
    add_candidate(out, default_home / "packages/standalone/current/bin/codex")
    add_candidate(out, default_home / "packages/standalone/current/codex")

    # Account-specific standalone installations can exist because each managed
    # account has its own CODEX_HOME.
    accounts = ROOT / "accounts"
    if accounts.exists():
        for account_home in sorted(accounts.glob("*/home")):
            add_candidate(out, account_home / "packages/standalone/current/bin/codex")
            add_candidate(out, account_home / "packages/standalone/current/codex")

    # npm/bun/system installs and any other Codex visible on PATH.
    wrapper_dir = str(WRAPPER.parent)
    for raw in os.environ.get("PATH", "").split(os.pathsep):
        if not raw:
            continue
        pdir = Path(raw).expanduser()
        if str(pdir) == wrapper_dir:
            continue
        add_candidate(out, pdir / "codex")

    return out


def parse_version(text: str) -> tuple[tuple[int, int, int], bool]:
    m = re.search(r"(\d+)\.(\d+)\.(\d+)([-+][0-9A-Za-z.-]+)?", text)
    if not m:
        return (0, 0, 0), False
    prerelease = bool(m.group(4) and m.group(4).startswith("-"))
    return tuple(int(x) for x in m.group(1, 2, 3)), prerelease


def version(path: Path) -> tuple[tuple[int, int, int], str | None, bool]:
    try:
        p = subprocess.run(
            [str(path), "--version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired):
        return (0, 0, 0), None, False

    if p.returncode != 0:
        return (0, 0, 0), None, False

    text = p.stdout.strip()
    key, prerelease = parse_version(text)
    return key, text or None, prerelease


def method(path: Path) -> str:
    try:
        resolved = str(path.resolve())
    except OSError:
        resolved = str(path)

    if "/packages/standalone/" in resolved:
        return "standalone"
    if "node_modules/@openai/codex" in resolved or "/npm/" in resolved:
        return "npm"
    if "/bun/" in resolved or "/.bun/" in resolved:
        return "bun"
    return "path"


def cache_valid(cache: dict, ttl: int) -> bool:
    try:
        checked = float(cache.get("checked_epoch", 0))
        p = Path(cache["path"]).expanduser()
    except Exception:
        return False

    if time.time() - checked > ttl:
        return False

    try:
        return p.exists() and os.access(p, os.X_OK) and not is_manager_wrapper(p)
    except OSError:
        return False


def discover(force: bool = False) -> dict:
    cfg = load_json(CFG)
    ttl = int(cfg.get("runtime_check_ttl_seconds", DEFAULT_TTL) or DEFAULT_TTL)
    policy = str(cfg.get("prerelease_policy", "stable")).lower()

    with RuntimeLock():
        cache = load_json(CACHE)
        if not force and cache_valid(cache, ttl):
            if policy != "stable" or not cache.get("prerelease", False):
                return cache

        found = candidates()
        if not found:
            raise SystemExit(
                "Codex official runtime not found. Install/update Codex, then run "
                "'codex-runtime --manager-runtime-info'."
            )

        ranked = []
        for idx, p in enumerate(found):
            key, text, prerelease = version(p)
            ranked.append((key, -idx, p, text, prerelease))

        if policy == "stable":
            stable = [item for item in ranked if not item[4]]
            if stable:
                ranked = stable
            else:
                raise SystemExit(
                    "Only prerelease Codex runtimes were found while prerelease_policy=stable. "
                    "Install a stable Codex or set prerelease_policy to allow-prerelease."
                )

        ranked.sort(key=lambda item: (item[0], item[1]), reverse=True)
        key, _, chosen, text, prerelease = ranked[0]

        data = {
            "path": str(chosen),
            "version": text,
            "version_key": list(key),
            "prerelease": prerelease,
            "policy": policy,
            "method": method(chosen),
            "checked_epoch": time.time(),
        }
        save_json(CACHE, data)
        return data


def main() -> None:
    args = sys.argv[1:]

    if args == ["--manager-runtime-info"]:
        info = discover(force=True)
        print(json.dumps(info, indent=2, sort_keys=True))
        return

    if args == ["--manager-runtime-refresh"]:
        try:
            CACHE.unlink()
        except FileNotFoundError:
            pass
        info = discover(force=True)
        print(json.dumps(info, indent=2, sort_keys=True))
        return

    info = discover(force=False)
    chosen = info["path"]

    if os.environ.get("CODEX_MANAGER_RUNTIME_DEBUG") == "1":
        print(
            f"[codex-runtime] {chosen} ({info.get('version') or 'unknown'}, "
            f"{info.get('method') or 'unknown'})",
            file=sys.stderr,
        )

    os.execvpe(chosen, [chosen, *args], os.environ)


if __name__ == "__main__":
    main()
