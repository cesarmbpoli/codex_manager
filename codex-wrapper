#!/usr/bin/env bash
set -euo pipefail

MANAGER="${CODEX_ACCOUNT_MANAGER_BIN:-$HOME/.local/bin/codex-account}"
RUNTIME="${CODEX_MANAGER_RUNTIME_BIN:-$HOME/.local/lib/codex-manager/codex-runtime}"

case "${1:-}" in
  --version|-V|--help|-h)
    exec "$RUNTIME" "$@"
    ;;
  exec)
    shift
    exec "$MANAGER" exec -- "$@"
    ;;
  *)
    exec "$MANAGER" run -- "$@"
    ;;
esac
